{
  "$schema": "https://fama.stdlaw.cn/config.json",
  // Developing fama itself: keep the engineering agent as the working default
  // (the product-level default for end users is "lawyer").
  "default_agent": "build",
  "provider": {},
  "permission": {},
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "fama-local": {
      "path": "~/.local/share/fama",
      "description": "Contains fama logs and data",
    },
  },
  "mcp": {},
  "tools": {},
}
